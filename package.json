{
	"name": "activity-planner",
	"version": "0.0.0-unreleased",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm lint && pnpm format:check",
		"sync": "git switch main && git pull && pnpm install",
		"sync:branch": "git fetch origin && git merge --no-commit origin/main && pnpm install"
	},
	"dependencies": {
		"leaflet": "^1.9.4",
		"mongoose": "^9.6.2",
		"next": "16.4.6",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-hot-toast": "^2.6.0",
		"react-leaflet": "^5.0.0",
		"react-leaflet-cluster": "^4.1.3",
		"styled-components": "^6.0.2",
		"swr": "^2.4.1",
		"use-local-storage-state": "^19.5.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.18.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "24.x"
	},
	"devDependencies": {
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.4.6",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"prettier": "^3.10.0"
	},
	"packageManager": "pnpm@12.18.0"
}
